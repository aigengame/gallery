; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Verdant"
config/description="A quiet meadow to explore. 自由漫步于风中的青野。"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://content/icon.svg"

[autoload]

GdaHarness="*res://addons/gda_harness/gda_harness.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=2560
window/size/window_height_override=1440
window/stretch/mode="viewport"

